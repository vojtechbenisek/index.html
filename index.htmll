<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>IRON PR | Gym & PR Deník</title>
    <!-- Načtení moderního písma Inter pro perfektní čitelnost na mobilu i PC -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        /* ==========================================================================
           1. DESIGN TOKENS & ČERVENO-ČERNÁ KARBONOVÁ TEXTURA POZADÍ
           ========================================================================== */
        :root {
            --bg-base: #070506;
            --bg-card: rgba(19, 14, 16, 0.94);
            --bg-card-elevated: #140f11;
            --bg-input: #1e171a;
            --red-primary: #e61919;
            --red-dark: #940808;
            --orange-accent: #ff5722;
            --red-glow: rgba(230, 25, 25, 0.38);
            --text-main: #ffffff;
            --text-muted: #a3989d;
            --border-color: rgba(230, 25, 25, 0.34);
            --ease-smooth: cubic-bezier(0.22, 1, 0.36, 1);
            --ease-spring: cubic-bezier(0.25, 1.12, 0.4, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            max-width: 100%;
            overflow-x: hidden;
        }

        /* Tkaný červeno-černý karbon se saténovým odleskem a tmavou vinětací po okrajích */
        body {
            background-color: var(--bg-base);
            background-image:
                radial-gradient(circle at 50% 15%, rgba(220, 22, 22, 0.16) 0%, rgba(110, 6, 8, 0.08) 44%, rgba(0, 0, 0, 0.92) 100%),
                linear-gradient(27deg, #100a0b 5px, transparent 5px),
                linear-gradient(207deg, #100a0b 5px, transparent 5px),
                linear-gradient(27deg, #2d080c 5px, transparent 5px),
                linear-gradient(207deg, #2d080c 5px, transparent 5px),
                linear-gradient(90deg, #190608 10px, transparent 10px),
                linear-gradient(#14090b 25%, #0b0809 25%, #0b0809 50%, transparent 50%, transparent 75%, #230709 75%, #230709);
            background-size: 100% 100%, 20px 20px, 20px 20px, 20px 20px, 20px 20px, 20px 20px, 20px 20px;
            background-position: 0 0, 0 5px, 10px 0, 0 10px, 10px 5px, 0 0, 0 0;
            background-attachment: fixed;
            color: var(--text-main);
            min-height: 100vh;
            padding-bottom: 36px;
        }

        /* ==========================================================================
           2. STICKY GLASSMORPHIC HLAVIČKA
           ========================================================================== */
        header {
            background: linear-gradient(180deg, rgba(16, 7, 8, 0.95) 0%, rgba(10, 6, 7, 0.88) 100%);
            padding: 13px 16px;
            border-bottom: 1px solid rgba(230, 25, 25, 0.36);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 30;
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 900;
            font-size: 1.2rem;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .logo span {
            color: var(--red-primary);
            text-shadow: 0 0 14px rgba(230, 25, 25, 0.45);
        }

        .header-stats-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(230, 25, 25, 0.16);
            border: 1px solid rgba(230, 25, 25, 0.42);
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 0.74rem;
            font-weight: 800;
            color: #ffd6d6;
            box-shadow: 0 2px 12px rgba(230, 25, 25, 0.18);
        }

        .container {
            width: 100%;
            max-width: 500px;
            margin: 0 auto;
            padding: 14px;
        }

        /* ==========================================================================
           3. MOTIVAČNÍ LIŠTA (ZMĚNA KAŽDÝCH 5 MINUT + ODPOČET + SLIDE ANIMACE)
           ========================================================================== */
        .motivation-bar {
            position: relative;
            background: linear-gradient(135deg, rgba(29, 12, 14, 0.96) 0%, rgba(14, 10, 12, 0.96) 100%);
            border: 1px solid rgba(230, 25, 25, 0.46);
            border-radius: 18px;
            padding: 12px 14px 15px;
            margin-bottom: 12px;
            box-shadow: 0 10px 26px rgba(0, 0, 0, 0.68), inset 0 1px 0 rgba(255, 255, 255, 0.06);
            cursor: pointer;
            overflow: hidden;
            min-height: 44px;
            transition: transform 0.2s var(--ease-smooth), border-color 0.2s ease;
            user-select: none;
        }

        .motivation-bar:active {
            transform: scale(0.985);
            border-color: var(--orange-accent);
        }

        .motivation-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 6px;
        }

        .motivation-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.68rem;
            font-weight: 900;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #ff7043;
        }

        .motivation-timer-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(230, 25, 25, 0.18);
            border: 1px solid rgba(230, 25, 25, 0.36);
            border-radius: 999px;
            padding: 2px 9px;
            font-size: 0.68rem;
            font-weight: 800;
            color: #ffb8b8;
            font-variant-numeric: tabular-nums;
        }

        .motivation-text-viewport {
            overflow: hidden;
            min-height: 2.5em;
            display: flex;
            align-items: center;
        }

        .motivation-text {
            width: 100%;
            font-size: 0.9rem;
            font-weight: 800;
            line-height: 1.32;
            color: #ffffff;
            transition: opacity 0.26s var(--ease-smooth), transform 0.3s var(--ease-smooth);
            will-change: transform, opacity;
        }

        .motivation-text.slide-out-left {
            opacity: 0;
            transform: translate3d(-32px, 0, 0);
        }

        .motivation-text.slide-in-right-prep {
            opacity: 0;
            transform: translate3d(32px, 0, 0);
            transition: none;
        }

        .motivation-progress-track {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 3px;
            background: rgba(255, 255, 255, 0.08);
        }

        .motivation-progress-fill {
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, var(--red-primary), var(--orange-accent));
            transform-origin: left center;
            transition: width 0.95s linear;
        }

        /* ==========================================================================
           4. PŘEPÍNATELNÁ LIŠTA SVALOVÝCH PARTIÍ (RUCE, ZÁDA, BŘICHO, NOHY)
           ========================================================================== */
        .muscle-tabs-bar {
            position: relative;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            background: linear-gradient(145deg, rgba(22, 14, 16, 0.96), rgba(12, 9, 10, 0.96));
            border: 1px solid rgba(230, 25, 25, 0.38);
            border-radius: 18px;
            padding: 6px;
            margin-bottom: 14px;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.62), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            user-select: none;
        }

        .muscle-tab-indicator {
            position: absolute;
            top: 6px;
            bottom: 6px;
            left: 6px;
            width: calc((100% - 12px - 18px) / 4);
            background: linear-gradient(135deg, var(--red-primary), var(--red-dark));
            border-radius: 13px;
            box-shadow: 0 4px 16px var(--red-glow), inset 0 1px 0 rgba(255, 255, 255, 0.24);
            transition: transform 0.36s var(--ease-spring);
            z-index: 1;
            pointer-events: none;
            will-change: transform;
        }

        .muscle-tab-btn {
            position: relative;
            z-index: 2;
            min-height: 46px;
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 0.2px;
            padding: 8px 4px;
            border-radius: 13px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            transition: color 0.22s ease, transform 0.16s var(--ease-smooth);
        }

        .muscle-tab-btn:active {
            transform: scale(0.94);
        }

        .muscle-tab-btn.active {
            color: #ffffff;
        }

        .muscle-tab-count {
            font-size: 0.64rem;
            font-weight: 800;
            padding: 1px 7px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
            color: inherit;
            transition: background 0.22s ease, color 0.22s ease;
        }

        .muscle-tab-btn.active .muscle-tab-count {
            background: rgba(0, 0, 0, 0.34);
            color: #ffe3e3;
        }

        /* ==========================================================================
           5. HORNÍ MŘÍŽKA: TĚLESNÁ VÁHA & PROGRES + PŘEHLED AKTIVNÍ PARTIE
           ========================================================================== */
        .section-caption {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-muted);
            margin: 10px 2px 9px;
        }

        .top-overview-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 6px;
        }

        .sq-tile {
            position: relative;
            aspect-ratio: 1 / 1;
            width: 100%;
            min-height: 44px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 22px;
            padding: 13px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: stretch;
            text-align: left;
            color: var(--text-main);
            cursor: pointer;
            box-shadow: 0 10px 26px rgba(0, 0, 0, 0.68);
            transition: transform 0.26s var(--ease-smooth),
                        border-color 0.22s ease,
                        box-shadow 0.24s ease,
                        opacity 0.22s ease;
            z-index: 1;
            overflow: hidden;
            will-change: transform;
        }

        .sq-tile:hover {
            border-color: rgba(230, 25, 25, 0.72);
        }

        .sq-tile:active {
            transform: scale(0.96);
        }

        .sq-tile.tile-is-origin {
            opacity: 0.14;
            transform: scale(0.94);
        }

        .sq-tile.party-summary-tile {
            background: linear-gradient(145deg, rgba(28, 13, 15, 0.95), rgba(14, 10, 12, 0.95));
            border-color: rgba(230, 25, 25, 0.36);
        }

        .tile-top-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .round-icon-badge {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--red-primary), var(--red-dark));
            border: 1.5px solid rgba(255, 255, 255, 0.18);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            box-shadow: 0 4px 14px var(--red-glow);
        }

        .round-machine-thumb {
            width: 48px;
            height: 48px;
            min-width: 48px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--red-primary);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.72);
            background: #120d0f;
        }

        .tile-pill {
            font-size: 0.68rem;
            font-weight: 800;
            padding: 4px 9px;
            border-radius: 999px;
            background: rgba(230, 25, 25, 0.18);
            border: 1px solid rgba(230, 25, 25, 0.4);
            color: #ff9c9c;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
        }

        .tile-pill.positive {
            background: rgba(46, 204, 113, 0.14);
            border-color: rgba(46, 204, 113, 0.36);
            color: #7bed9f;
        }

        .tile-weight-mid {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            margin-top: 2px;
        }

        .tile-main-value {
            font-size: 1.52rem;
            font-weight: 900;
            line-height: 1.1;
            letter-spacing: -0.3px;
        }

        .tile-main-value small {
            font-size: 0.84rem;
            color: var(--red-primary);
            font-weight: 800;
        }

        .mini-sparkline-box {
            width: 62px;
            height: 28px;
            flex-shrink: 0;
        }

        .mini-sparkline-box svg {
            width: 100%;
            height: 100%;
            overflow: visible;
        }

        .tile-title {
            font-size: 0.86rem;
            font-weight: 800;
            line-height: 1.24;
            color: #ffffff;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .tile-sub {
            font-size: 0.72rem;
            color: var(--text-muted);
            font-weight: 600;
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Speciální styl dlaždice Přidat stroj */
        .sq-tile.add-tile {
            border: 1.5px dashed rgba(230, 25, 25, 0.6);
            background: linear-gradient(145deg, rgba(32, 12, 15, 0.94), rgba(15, 11, 13, 0.94));
            align-items: center;
            justify-content: center;
            text-align: center;
            gap: 10px;
        }

        .add-round-badge {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--red-primary), var(--orange-accent));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            box-shadow: 0 6px 22px var(--red-glow);
        }

        .machine-mini-badges {
            display: flex;
            align-items: center;
            gap: 5px;
            flex-wrap: wrap;
            margin-top: 5px;
        }

        .mini-chip {
            font-size: 0.68rem;
            font-weight: 800;
            padding: 3px 7px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
            color: #e4dce0;
        }

        .mini-chip.pr {
            background: rgba(230, 25, 25, 0.25);
            color: #ff9c9c;
            border: 1px solid rgba(230, 25, 25, 0.42);
        }

        /* ==========================================================================
           6. ŽIVÝ HORIZONTÁLNÍ SWIPE CAROUSEL PRO 4 SVALOVÉ PARTIE
           ========================================================================== */
        .muscle-carousel-viewport {
            width: 100%;
            overflow: hidden;
            touch-action: pan-y;
            cursor: grab;
        }

        .muscle-carousel-viewport.is-dragging {
            cursor: grabbing;
        }

        .muscle-carousel-track {
            display: flex;
            width: 400%;
            transform: translate3d(0%, 0, 0);
            transition: transform 0.36s var(--ease-smooth);
            will-change: transform;
        }

        .muscle-carousel-track.no-transition {
            transition: none !important;
        }

        .muscle-slide-pane {
            width: 25%;
            flex: 0 0 25%;
            padding: 0 2px;
        }

        .tiles-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        /* ==========================================================================
           7. SYMETRICKÁ FLIP EXPANZE DLAŽDICE DO FULLSCREEN OVERLAY KARTY
           ========================================================================== */
        .tile-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(4, 2, 3, 0.88);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 80;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.32s var(--ease-smooth);
        }

        .tile-backdrop.active {
            opacity: 1;
            pointer-events: auto;
        }

        .expanded-square-stage {
            position: fixed;
            inset: 0;
            z-index: 90;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 14px;
            pointer-events: none;
            opacity: 0;
        }

        .expanded-square-stage.active {
            opacity: 1;
            pointer-events: auto;
        }

        .expanded-square-card {
            width: 100%;
            max-width: 480px;
            max-height: calc(100vh - 28px);
            overflow-y: auto;
            background: var(--bg-card-elevated);
            border: 1.5px solid rgba(230, 25, 25, 0.68);
            border-radius: 26px;
            padding: 18px;
            box-shadow: 0 24px 64px rgba(0, 0, 0, 0.95), 0 0 34px rgba(230, 25, 25, 0.25);
            transform-origin: center center;
            will-change: transform, opacity, border-radius;
        }

        .swipe-pill-hint {
            width: 42px;
            height: 4px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.24);
            margin: -6px auto 12px;
        }

        .expanded-top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            min-height: 44px;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            cursor: pointer;
            touch-action: pan-x;
        }

        .expanded-title-group {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .expanded-title-text h2 {
            font-size: 1.05rem;
            font-weight: 900;
            line-height: 1.2;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .expanded-title-text p {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .close-round-btn {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.18s ease;
        }

        .close-round-btn:active {
            transform: scale(0.92);
            background: rgba(230, 25, 25, 0.3);
        }

        /* ==========================================================================
           8. FORMULÁŘE, TLAČÍTKA, OŘEZ FOTKY 4:3 A GRAF VÁHY
           ========================================================================== */
        .form-group {
            margin-bottom: 13px;
        }

        .form-group label {
            display: block;
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: var(--text-muted);
            font-weight: 800;
            margin-bottom: 6px;
        }

        input[type="text"],
        input[type="number"],
        input[type="date"],
        select {
            width: 100%;
            min-height: 44px;
            background: var(--bg-input);
            border: 1px solid rgba(255, 255, 255, 0.13);
            border-radius: 12px;
            padding: 11px 12px;
            color: #ffffff;
            font-size: 0.95rem;
            font-weight: 700;
            outline: none;
            transition: border-color 0.2s ease;
        }

        input:focus,
        select:focus {
            border-color: var(--red-primary);
        }

        input[type="date"] {
            color-scheme: dark;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .form-row-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .btn {
            min-height: 44px;
            background: linear-gradient(135deg, var(--red-primary), var(--red-dark));
            color: #ffffff;
            border: none;
            border-radius: 13px;
            padding: 12px 16px;
            font-size: 0.9rem;
            font-weight: 800;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 6px 18px var(--red-glow);
            transition: transform 0.18s var(--ease-smooth), opacity 0.2s ease;
        }

        .btn:active {
            transform: scale(0.97);
        }

        .btn-secondary {
            background: var(--bg-input);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: none;
        }

        .btn-danger {
            background: rgba(230, 25, 25, 0.18);
            border: 1px solid rgba(230, 25, 25, 0.48);
            color: #ff8a8a;
            box-shadow: none;
        }

        /* Ořezávač fotky 4:3 */
        .photo-upload-area {
            border: 2px dashed rgba(230, 25, 25, 0.48);
            border-radius: 16px;
            padding: 18px 14px;
            text-align: center;
            background: rgba(230, 25, 25, 0.05);
            cursor: pointer;
            min-height: 44px;
        }

        .cropper-wrapper {
            display: none;
        }

        .cropper-box {
            position: relative;
            width: 100%;
            aspect-ratio: 4 / 3;
            background: #090708;
            border-radius: 14px;
            overflow: hidden;
            border: 2px solid var(--red-primary);
            touch-action: none;
            cursor: grab;
        }

        .cropper-box img {
            position: absolute;
            top: 50%;
            left: 50%;
            transform-origin: center center;
            user-select: none;
            -webkit-user-drag: none;
        }

        .crop-grid {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-image:
                linear-gradient(to right, rgba(255, 255, 255, 0.16) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.16) 1px, transparent 1px);
            background-size: 33.33% 33.33%;
        }

        .zoom-control {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-muted);
        }

        input[type="range"] {
            flex: 1;
            min-height: 36px;
            accent-color: var(--red-primary);
        }

        /* Detail stroje ve zvětšeném čtverci */
        .detail-photo-frame {
            width: 100%;
            aspect-ratio: 4 / 3;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(230, 25, 25, 0.42);
            margin-bottom: 14px;
            background: #0c090a;
        }

        .detail-photo-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .detail-category-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .detail-category-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(230, 25, 25, 0.18);
            border: 1px solid rgba(230, 25, 25, 0.44);
            color: #ffb3b3;
            border-radius: 999px;
            padding: 5px 12px;
            font-size: 0.74rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }

        .detail-volume-badge {
            font-size: 0.74rem;
            font-weight: 700;
            color: var(--text-muted);
        }

        .detail-metrics-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            background: var(--bg-input);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 12px 8px;
            text-align: center;
            margin-bottom: 14px;
        }

        .detail-metric-label {
            display: block;
            font-size: 0.68rem;
            text-transform: uppercase;
            color: var(--text-muted);
            font-weight: 800;
            margin-bottom: 4px;
        }

        .detail-metric-value {
            font-size: 1.15rem;
            font-weight: 900;
        }

        .detail-metric-value.accent {
            color: var(--red-primary);
        }

        /* Graf váhy a sbalovací historie vážení */
        .chart-wrapper {
            position: relative;
            width: 100%;
            height: 192px;
            background: rgba(10, 7, 8, 0.88);
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 16px;
            padding: 8px;
            margin-top: 10px;
        }

        #weightChart {
            width: 100%;
            height: 100%;
            display: block;
            touch-action: none;
        }

        .chart-tooltip {
            position: absolute;
            top: 10px;
            right: 12px;
            background: rgba(230, 25, 25, 0.24);
            border: 1px solid rgba(230, 25, 25, 0.52);
            border-radius: 999px;
            padding: 3px 10px;
            font-size: 0.72rem;
            font-weight: 800;
            color: #ffd6d6;
            pointer-events: none;
        }

        .weight-history-wrap {
            margin-top: 14px;
            background: rgba(12, 9, 10, 0.76);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            overflow: hidden;
        }

        .weight-history-toggle {
            width: 100%;
            min-height: 44px;
            background: transparent;
            border: none;
            color: #ffffff;
            padding: 11px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-weight: 800;
        }

        .weight-history-toggle svg {
            transition: transform 0.32s var(--ease-smooth);
        }

        .weight-history-wrap.open .weight-history-toggle svg {
            transform: rotate(180deg);
        }

        .weight-history-drawer {
            display: grid;
            grid-template-rows: 0fr;
            opacity: 0;
            transform: translateY(-8px);
            transition: grid-template-rows 0.34s var(--ease-smooth),
                        opacity 0.26s ease,
                        transform 0.34s var(--ease-smooth);
        }

        .weight-history-wrap.open .weight-history-drawer {
            grid-template-rows: 1fr;
            opacity: 1;
            transform: translateY(0);
        }

        .weight-history-drawer-inner {
            overflow: hidden;
            padding: 0 10px;
            transition: padding 0.34s var(--ease-smooth);
        }

        .weight-history-wrap.open .weight-history-drawer-inner {
            padding: 0 10px 10px;
        }

        .weight-history-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
            max-height: 168px;
            overflow-y: auto;
        }

        .weight-history-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-input);
            padding: 8px 11px;
            border-radius: 10px;
            font-size: 0.82rem;
            font-weight: 700;
        }

        .weight-del-btn {
            background: rgba(230, 25, 25, 0.18);
            border: 1px solid rgba(230, 25, 25, 0.38);
            color: #ff8a8a;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* ==========================================================================
           9. VLASTNÍ SLIDE-UP POTVRZOVACÍ DIALOG SMAZÁNÍ & TOAST NOTIFIKACE
           ========================================================================== */
        .modal {
            display: flex;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.88);
            z-index: 120;
            padding: 16px;
            align-items: flex-end;
            justify-content: center;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.28s var(--ease-smooth);
        }

        @media (min-width: 520px) {
            .modal {
                align-items: center;
            }
        }

        .modal.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-content {
            background: var(--bg-card-elevated);
            border: 1px solid var(--border-color);
            border-top: 3px solid var(--red-primary);
            border-radius: 24px;
            width: 100%;
            max-width: 400px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 22px 54px rgba(0, 0, 0, 0.92);
            opacity: 0;
            transform: translate3d(0, 48px, 0) scale(0.96);
            transition: transform 0.32s var(--ease-smooth), opacity 0.26s ease;
        }

        .modal.active .modal-content {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
        }

        .toast-banner {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translate3d(-50%, 90px, 0);
            background: linear-gradient(135deg, #261013, #140d0f);
            border: 1px solid rgba(230, 25, 25, 0.68);
            color: #ffffff;
            padding: 10px 18px;
            border-radius: 999px;
            font-size: 0.82rem;
            font-weight: 800;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.88);
            z-index: 150;
            opacity: 0;
            pointer-events: none;
            transition: transform 0.32s var(--ease-smooth), opacity 0.28s ease;
            white-space: nowrap;
        }

        .toast-banner.show {
            opacity: 1;
            transform: translate3d(-50%, 0, 0);
        }
    </style>
</head>
<body>

<!-- STICKY GLASSMORPHIC HLAVIČKA -->
<header>
    <div class="logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e61919" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6.5 6.5h11"></path>
            <path d="M6.5 17.5h11"></path>
            <path d="M3 10v4"></path>
            <path d="M21 10v4"></path>
            <path d="M6.5 4v16"></path>
            <path d="M17.5 4v16"></path>
        </svg>
        IRON<span>PR</span>
    </div>
    <div class="header-stats-pill" id="headerSummaryPill">
        0 strojů • Max PR 0 kg
    </div>
</header>

<main class="container">

    <!-- 1. MOTIVAČNÍ LIŠTA (ZMĚNA KAŽDÝCH 5 MINUT + ODPOČET + SLIDE ANIMACE) -->
    <div class="motivation-bar" id="motivationBar" onclick="nextMotivationQuote(true)" role="button" tabindex="0" aria-label="Motivační věta – klepnutím změníš na další">
        <div class="motivation-top">
            <span class="motivation-label">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                </svg>
                MOTIVACE DO SÉRIE
            </span>
            <span class="motivation-timer-pill" id="motivationCountdown">5:00</span>
        </div>
        <div class="motivation-text-viewport">
            <div class="motivation-text" id="motivationText">Nečum do mobilu a zvedej to železo.</div>
        </div>
        <div class="motivation-progress-track">
            <div class="motivation-progress-fill" id="motivationProgressFill"></div>
        </div>
    </div>

    <!-- 2. INTERAKTIVNÍ PŘEPÍNATELNÁ LIŠTA SVALOVÝCH PARTIÍ (RUCE, ZÁDA, BŘICHO, NOHY) -->
    <nav class="muscle-tabs-bar" id="muscleTabsBar" aria-label="Výběr svalové partie">
        <div class="muscle-tab-indicator" id="muscleTabIndicator"></div>
        <button type="button" class="muscle-tab-btn active" data-muscle="ruce" data-index="0" onclick="switchMuscleCategory('ruce')">
            <span>Ruce</span>
            <span class="muscle-tab-count" id="tabCount-ruce">0</span>
        </button>
        <button type="button" class="muscle-tab-btn" data-muscle="zada" data-index="1" onclick="switchMuscleCategory('zada')">
            <span>Záda</span>
            <span class="muscle-tab-count" id="tabCount-zada">0</span>
        </button>
        <button type="button" class="muscle-tab-btn" data-muscle="bricho" data-index="2" onclick="switchMuscleCategory('bricho')">
            <span>Břicho</span>
            <span class="muscle-tab-count" id="tabCount-bricho">0</span>
        </button>
        <button type="button" class="muscle-tab-btn" data-muscle="nohy" data-index="3" onclick="switchMuscleCategory('nohy')">
            <span>Nohy</span>
            <span class="muscle-tab-count" id="tabCount-nohy">0</span>
        </button>
    </nav>

    <!-- 3. HORNÍ MŘÍŽKA: TĚLESNÁ VÁHA & PROGRES + PŘEHLED AKTIVNÍ PARTIE -->
    <div class="section-caption">
        <span>Přehled & Tělesná váha</span>
        <span>Klepni na čtverec</span>
    </div>

    <section class="top-overview-grid" aria-label="Tělesná váha a přehled partie">
        <!-- Čtvercová dlaždice: Tělesná váha & Progres (včetně mini trend sparkline) -->
        <button type="button" class="sq-tile weight-tile" id="tile-weight" onclick="openExpandedSquare('weight', null, this)">
            <div class="tile-top-row">
                <div class="round-icon-badge" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3a9 9 0 1 0 9 9"></path>
                        <path d="M12 12l5.5-5.5"></path>
                        <circle cx="12" cy="12" r="2"></circle>
                    </svg>
                </div>
                <span class="tile-pill" id="weightTileDiffBadge">Bez záznamu</span>
            </div>

            <div class="tile-weight-mid">
                <div class="tile-main-value" id="weightTileMainVal">-- <small>kg</small></div>
                <div class="mini-sparkline-box" id="weightMiniSparkline" aria-hidden="true"></div>
            </div>

            <div>
                <div class="tile-title">Tělesná váha & Progres</div>
                <div class="tile-sub" id="weightTileLastDate">Zapiš první váhu</div>
            </div>
        </button>

        <!-- Čtvercová dlaždice: Přehled aktivní partie (klepnutím přeskočí na další partii) -->
        <button type="button" class="sq-tile party-summary-tile" id="tile-party-overview" onclick="cycleNextMuscleCategory()">
            <div class="tile-top-row">
                <div class="round-icon-badge" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 21 12 15 6"></polyline>
                        <path d="M3 12h18"></path>
                    </svg>
                </div>
                <span class="tile-pill" id="partyOverviewPrBadge">Max 0 kg</span>
            </div>

            <div>
                <div class="tile-main-value" id="partyOverviewTitle">Ruce</div>
            </div>

            <div>
                <div class="tile-title" id="partyOverviewCountText">0 strojů v partii</div>
                <div class="tile-sub">Táhni prstem nebo klepni</div>
            </div>
        </button>
    </section>

    <!-- 4. ŽIVÝ HORIZONTÁLNÍ SWIPE CAROUSEL PRO 4 SVALOVÉ PARTIE (RUCE, ZÁDA, BŘICHO, NOHY) -->
    <div class="section-caption">
        <span id="carouselCaptionTitle">Stroje – Ruce</span>
        <span>← Táhni / přepínej →</span>
    </div>

    <div class="muscle-carousel-viewport" id="muscleCarouselViewport">
        <div class="muscle-carousel-track" id="muscleCarouselTrack">
            <!-- Panel 0: Ruce -->
            <div class="muscle-slide-pane" data-muscle="ruce">
                <div class="tiles-grid" id="grid-ruce"></div>
            </div>
            <!-- Panel 1: Záda -->
            <div class="muscle-slide-pane" data-muscle="zada">
                <div class="tiles-grid" id="grid-zada"></div>
            </div>
            <!-- Panel 2: Břicho -->
            <div class="muscle-slide-pane" data-muscle="bricho">
                <div class="tiles-grid" id="grid-bricho"></div>
            </div>
            <!-- Panel 3: Nohy -->
            <div class="muscle-slide-pane" data-muscle="nohy">
                <div class="tiles-grid" id="grid-nohy"></div>
            </div>
        </div>
    </div>

</main>

<!-- ZATMAVENÉ POZADÍ & SYMETRICKÝ FLIP FULLSCREEN OVERLAY -->
<div class="tile-backdrop" id="tileBackdrop" onclick="closeExpandedSquare()"></div>

<div class="expanded-square-stage" id="expandedSquareStage" role="dialog" aria-modal="true" aria-labelledby="expandedSquareTitle">
    <div class="expanded-square-card" id="expandedSquareCard" onclick="event.stopPropagation()">
        <div class="swipe-pill-hint" aria-hidden="true"></div>
        <div class="expanded-top-bar" id="expandedTopBar" onclick="closeExpandedSquare()" title="Klepnutím nebo potažením dolů zmenšíš zpět">
            <div class="expanded-title-group">
                <div class="round-icon-badge" id="expandedSquareIcon"></div>
                <div class="expanded-title-text">
                    <h2 id="expandedSquareTitle">Název</h2>
                    <p id="expandedSquareSub">Podtitulek</p>
                </div>
            </div>
            <button type="button" class="close-round-btn" onclick="event.stopPropagation(); closeExpandedSquare();" aria-label="Zavřít detail">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- 1. OBSAH PRO: PŘIDAT / UPRAVIT STROJ + OŘEZ FOTKY 4:3 -->
        <div id="expandedAddView" style="display: none;">
            <input type="hidden" id="editMachineId">

            <div class="form-group">
                <label>Fotka stroje (výřez 4:3)</label>
                <input type="file" id="photoInput" accept="image/*" style="display: none;" onchange="handleImageSelect(event)">

                <div class="photo-upload-area" id="uploadTrigger" onclick="document.getElementById('photoInput').click()">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#e61919" stroke-width="2.2" style="margin-bottom: 6px;">
                        <rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
                        <circle cx="8.5" cy="8.5" r="1.5"></circle>
                        <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                    <div style="font-weight: 800; font-size: 0.9rem;">Vybrat nebo vyfotit stroj</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">Po nahrání posuň prstem a přibliž výřez</div>
                </div>

                <div class="cropper-wrapper" id="cropperWrapper">
                    <div class="cropper-box" id="cropperBox">
                        <img id="cropImage" alt="Náhled výřezu stroje">
                        <div class="crop-grid"></div>
                    </div>
                    <div class="zoom-control">
                        <span>Zoom:</span>
                        <input type="range" id="zoomSlider" min="1" max="3" step="0.05" value="1" oninput="updateCropTransform()">
                        <button type="button" class="btn btn-secondary" style="padding: 5px 10px; font-size: 0.74rem;" onclick="document.getElementById('photoInput').click()">Jiná</button>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Svalová partie</label>
                <select id="machineCategoryInput">
                    <option value="ruce">Ruce</option>
                    <option value="zada">Záda</option>
                    <option value="bricho">Břicho</option>
                    <option value="nohy">Nohy</option>
                </select>
            </div>

            <div class="form-group">
                <label>Název stroje / cviku</label>
                <input type="text" id="machineNameInput" placeholder="Např. Leg Press, Bench Press, Kladka...">
            </div>

            <div class="form-row-3">
                <div class="form-group">
                    <label>Max PR (kg)</label>
                    <input type="number" id="machinePrInput" step="0.5" min="0" placeholder="kg">
                </div>
                <div class="form-group">
                    <label>Série</label>
                    <input type="number" id="machineSetsInput" min="0" placeholder="počet">
                </div>
                <div class="form-group">
                    <label>Opakování</label>
                    <input type="number" id="machineRepsInput" min="0" placeholder="počet">
                </div>
            </div>

            <button type="button" class="btn" style="width: 100%; margin-top: 6px; padding: 13px;" onclick="saveMachine()">
                Uložit stroj a PR
            </button>
        </div>

        <!-- 2. OBSAH PRO: TĚLESNÁ VÁHA & PROGRES -->
        <div id="expandedWeightView" style="display: none;">
            <div class="form-row-2">
                <div class="form-group">
                    <label>Aktuální váha (kg)</label>
                    <input type="number" id="bodyWeightInput" step="0.1" min="20" max="350" placeholder="Např. 82.5">
                </div>
                <div class="form-group">
                    <label>Datum vážení</label>
                    <input type="date" id="bodyWeightDateInput">
                </div>
            </div>

            <button type="button" class="btn" style="width: 100%;" onclick="logBodyWeight()">
                Zapsat váhu do grafu
            </button>

            <div class="chart-wrapper">
                <div class="chart-tooltip" id="chartTooltip">Klepni na bod v grafu</div>
                <canvas id="weightChart"></canvas>
            </div>

            <!-- Sbalovací lišta historie vážení se slide animací -->
            <div class="weight-history-wrap open" id="weightHistoryWrap" style="display: none;">
                <button type="button" class="weight-history-toggle" onclick="toggleWeightHistoryDrawer()">
                    <span>Historie vážení (<span id="weightHistoryCount">0</span>)</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff5722" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
                <div class="weight-history-drawer">
                    <div class="weight-history-drawer-inner">
                        <div class="weight-history-list" id="weightHistoryList"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. OBSAH PRO: DETAIL KONKRÉTNÍHO STROJE -->
        <div id="expandedMachineView" style="display: none;"></div>
    </div>
</div>

<!-- VLASTNÍ SLIDE-UP POTVRZOVACÍ DIALOG PRO SMAZÁNÍ STROJE -->
<div class="modal" id="deleteConfirmModal" onclick="closeDeleteModal()">
    <div class="modal-content" onclick="event.stopPropagation()">
        <div class="round-icon-badge" style="margin: 0 auto 12px; width: 48px; height: 48px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                <path d="M10 11v6"></path>
                <path d="M14 11v6"></path>
            </svg>
        </div>
        <h3 style="font-size: 1.05rem; font-weight: 900; margin-bottom: 6px;">Smazat tento stroj?</h3>
        <p id="deleteConfirmText" style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 18px; line-height: 1.4;">
            Opravdu chceš odstranit tento stroj a jeho PR?
        </p>
        <div class="form-row-2">
            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">Zrušit</button>
            <button type="button" class="btn" onclick="confirmDeleteMachine()">Smazat</button>
        </div>
    </div>
</div>

<!-- TOAST NOTIFIKACE -->
<div class="toast-banner" id="toastBanner" role="status" aria-live="polite"></div>

<script>
    /* ==========================================================================
       DATOVÝ MODEL & LOCALSTORAGE ('gym_machines', 'gym_weights')
       ========================================================================== */
    let machines = [];
    let bodyWeights = [];

    const MUSCLE_CATEGORIES = [
        { key: 'ruce', label: 'Ruce' },
        { key: 'zada', label: 'Záda' },
        { key: 'bricho', label: 'Břicho' },
        { key: 'nohy', label: 'Nohy' }
    ];
    let activeMuscleCategory = 'ruce';

    function getMuscleLabel(key) {
        const found = MUSCLE_CATEGORIES.find(c => c.key === key);
        return found ? found.label : 'Ruce';
    }

    function getMuscleIndex(key) {
        const idx = MUSCLE_CATEGORIES.findIndex(c => c.key === key);
        return idx === -1 ? 0 : idx;
    }

    // Načtení strojů a automatická migrace starších záznamů bez kategorie do 'ruce'
    try {
        machines = JSON.parse(localStorage.getItem('gym_machines')) || [];
        let migrated = false;
        machines = machines.map(m => {
            if (!m.category || !MUSCLE_CATEGORIES.some(c => c.key === m.category)) {
                migrated = true;
                return { ...m, category: 'ruce' };
            }
            return m;
        });
        if (migrated) {
            localStorage.setItem('gym_machines', JSON.stringify(machines));
        }
    } catch (e) {
        machines = [];
    }

    try {
        bodyWeights = JSON.parse(localStorage.getItem('gym_weights')) || [];
    } catch (e) {
        bodyWeights = [];
    }

    let activeExpandedType = null; // 'add' | 'weight' | 'machine' | null
    let activeExpandedMachineId = null;
    let activeOriginTileEl = null;
    let isSquareAnimating = false;
    let pendingDeleteId = null;
    let chartPointCoords = [];
    let activeChartPointIndex = null;
    let toastTimer = null;

    // Stav pro interaktivní 4:3 ořezávač fotek
    let rawImageObj = null;
    let existingCroppedData = null;
    let cropState = {
        scale: 1,
        x: 0,
        y: 0,
        dragging: false,
        startX: 0,
        startY: 0,
        baseW: 0,
        baseH: 0
    };

    /* ==========================================================================
       30 JEDNODUCHÝCH A PEPRNÝCH MOTIVAČNÍCH VĚT (ZMĚNA KAŽDÝCH 5 MINUT)
       ========================================================================== */
    const MOTIVATION_QUOTES = [
        "Nečum do mobilu a zvedej to železo.",
        "Nefňukej, ta činka se sama nezvedne.",
        "Bolí to? Dobře, aspoň víš, že se neflákáš.",
        "Přestaň se vymlouvat a nalož tam víc.",
        "Žádný sraní, dneska padne nový PR.",
        "Chceš výsledky, nebo jen kecat u zrcadla?",
        "Když nemůžeš, přidej ještě dvě opakování, kurva.",
        "Nejsi z cukru, tak zaber.",
        "Těžká váha se neptá, jestli máš náladu.",
        "Zadek z lavičky nezvedneš tím, že budeš čumět do blba.",
        "Dneska buď makáš naplno, nebo jdi rovnou domů.",
        "Každá série se počítá, tak to neodflákni.",
        "Neser se s tím a vytlač to nahoru.",
        "Svaly nerostou z výmluv, ale z dřiny.",
        "Ještě jedno opakování navíc dělá rozdíl.",
        "Nekecej, dýchej a zvedej.",
        "Včera jsi říkal zítra, tak teď kurva makej.",
        "Žádný polovičatý série, jeď to poctivě.",
        "Když už jsi v gymu, tak ze sebe vymáčkni všechno.",
        "Ta váha není těžká, jen ty jsi zatím slabej – změň to.",
        "Nehledáš zkratky, hledáš sílu.",
        "Zatni zuby a dotáhni tu sérii do konce.",
        "Nikdo to za tebe neodmaká, tak zaber.",
        "Buď silnější než tvoje výmluvy.",
        "Dneska žádný flákání, jedeš na krev.",
        "Když pálí svaly, tehdy to teprve začíná.",
        "Nech v tom gymu všechno a nebreč.",
        "Zvedni to, jakoby na tom záviselo všechno.",
        "Nejsi tu na procházce, jsi tu makat.",
        "Překonej sám sebe a zapiš nový rekord."
    ];

    const MOTIVATION_INTERVAL_MS = 300000; // 5 minut = 300 000 ms
    let motivationDeck = [];
    let lastQuoteText = '';
    let motivationDeadline = Date.now() + MOTIVATION_INTERVAL_MS;
    let motivationTickTimer = null;

    function refillMotivationDeck() {
        motivationDeck = [...MOTIVATION_QUOTES];
        for (let i = motivationDeck.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [motivationDeck[i], motivationDeck[j]] = [motivationDeck[j], motivationDeck[i]];
        }
        if (motivationDeck[motivationDeck.length - 1] === lastQuoteText && motivationDeck.length > 1) {
            const first = motivationDeck.shift();
            motivationDeck.push(first);
        }
    }

    function pullNextMotivationQuote() {
        if (motivationDeck.length === 0) {
            refillMotivationDeck();
        }
        const quote = motivationDeck.pop();
        lastQuoteText = quote;
        return quote;
    }

    function restartMotivationTimer() {
        motivationDeadline = Date.now() + MOTIVATION_INTERVAL_MS;
        updateMotivationCountdownUI();
        if (motivationTickTimer) clearInterval(motivationTickTimer);
        motivationTickTimer = setInterval(() => {
            const remaining = motivationDeadline - Date.now();
            if (remaining <= 0) {
                nextMotivationQuote(true);
            } else {
                updateMotivationCountdownUI();
            }
        }, 1000);
    }

    function updateMotivationCountdownUI() {
        const remaining = Math.max(0, motivationDeadline - Date.now());
        const totalSec = Math.ceil(remaining / 1000);
        const mins = Math.floor(totalSec / 60);
        const secs = totalSec % 60;
        const countdownEl = document.getElementById('motivationCountdown');
        const fillEl = document.getElementById('motivationProgressFill');

        if (countdownEl) {
            countdownEl.textContent = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
        }
        if (fillEl) {
            const pct = Math.max(0, Math.min(100, (remaining / MOTIVATION_INTERVAL_MS) * 100));
            fillEl.style.width = `${pct}%`;
        }
    }

    function nextMotivationQuote(animate = true) {
        const textEl = document.getElementById('motivationText');
        if (!textEl) return;

        const nextQuote = pullNextMotivationQuote();
        restartMotivationTimer();

        if (!animate) {
            textEl.textContent = nextQuote;
            return;
        }

        textEl.classList.add('slide-out-left');
        setTimeout(() => {
            textEl.classList.add('slide-in-right-prep');
            textEl.classList.remove('slide-out-left');
            textEl.textContent = nextQuote;
            requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                    textEl.classList.remove('slide-in-right-prep');
                });
            });
        }, 240);
    }

    /* ==========================================================================
       POMOCNÉ FUNKCE (DATUM, ESCAPE HTML, TOAST)
       ========================================================================== */
    function getTodayIsoDate() {
        const now = new Date();
        const y = now.getFullYear();
        const m = String(now.getMonth() + 1).padStart(2, '0');
        const d = String(now.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
    }

    function formatDisplayDate(isoOrRaw) {
        if (!isoOrRaw) return '';
        if (/^\d{4}-\d{2}-\d{2}$/.test(isoOrRaw)) {
            const [y, m, d] = isoOrRaw.split('-');
            return `${Number(d)}. ${Number(m)}. ${y}`;
        }
        return isoOrRaw;
    }

    function formatShortDate(isoOrRaw) {
        if (!isoOrRaw) return '';
        if (/^\d{4}-\d{2}-\d{2}$/.test(isoOrRaw)) {
            const [, m, d] = isoOrRaw.split('-');
            return `${Number(d)}.${Number(m)}.`;
        }
        return isoOrRaw;
    }

    function escapeHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function showToast(msg) {
        const el = document.getElementById('toastBanner');
        if (!el) return;
        el.textContent = msg;
        el.classList.add('show');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
            el.classList.remove('show');
        }, 2500);
    }

    /* ==========================================================================
       INICIALIZACE PO NAČTENÍ STRÁNKY
       ========================================================================== */
    document.addEventListener('DOMContentLoaded', () => {
        const dateInput = document.getElementById('bodyWeightDateInput');
        if (dateInput) dateInput.value = getTodayIsoDate();

        nextMotivationQuote(false);
        renderWeights();
        renderMachines();
        switchMuscleCategory(activeMuscleCategory, false);
        setupMuscleCarouselSwipe();
        setupCropperGestures();
        setupChartInteraction();
        setupExpandedSwipeGesture();
    });

    window.addEventListener('resize', () => {
        if (activeExpandedType === 'weight') {
            drawWeightChart();
        }
    });

    /* ==========================================================================
       INTERAKTIVNÍ PŘEPÍNÁNÍ PARTIÍ & ŽIVÝ SWIPE CAROUSEL (TOUCH + MYŠ)
       ========================================================================== */
    function updateMuscleUIState() {
        const idx = getMuscleIndex(activeMuscleCategory);
        const indicator = document.getElementById('muscleTabIndicator');
        const track = document.getElementById('muscleCarouselTrack');

        if (indicator) {
            indicator.style.transition = 'transform 0.36s cubic-bezier(0.25, 1.12, 0.4, 1)';
            indicator.style.transform = `translate3d(calc(${idx * 100}% + ${idx * 6}px), 0, 0)`;
        }

        if (track) {
            track.classList.remove('no-transition');
            track.style.transform = `translate3d(-${idx * 25}%, 0, 0)`;
        }

        document.querySelectorAll('.muscle-tab-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.muscle === activeMuscleCategory);
        });

        const label = getMuscleLabel(activeMuscleCategory);
        const catMachines = machines.filter(m => (m.category || 'ruce') === activeMuscleCategory);
        const catMaxPr = catMachines.length > 0 ? Math.max(...catMachines.map(m => Number(m.pr) || 0)) : 0;
        const countWord = catMachines.length === 1 ? 'stroj' : (catMachines.length >= 2 && catMachines.length <= 4 ? 'stroje' : 'strojů');

        const captionTitle = document.getElementById('carouselCaptionTitle');
        const partyTitle = document.getElementById('partyOverviewTitle');
        const partyCount = document.getElementById('partyOverviewCountText');
        const partyPr = document.getElementById('partyOverviewPrBadge');

        if (captionTitle) captionTitle.textContent = `Stroje – ${label}`;
        if (partyTitle) partyTitle.textContent = label;
        if (partyCount) partyCount.textContent = `${catMachines.length} ${countWord} v partii`;
        if (partyPr) partyPr.textContent = `Max ${catMaxPr} kg`;
    }

    function switchMuscleCategory(newCategory, animate = true) {
        if (!MUSCLE_CATEGORIES.some(c => c.key === newCategory)) return;
        activeMuscleCategory = newCategory;

        const track = document.getElementById('muscleCarouselTrack');
        if (!animate && track) {
            track.classList.add('no-transition');
        }
        updateMuscleUIState();
        if (!animate && track) {
            void track.offsetWidth;
            track.classList.remove('no-transition');
        }
    }

    function cycleNextMuscleCategory() {
        const currentIdx = getMuscleIndex(activeMuscleCategory);
        const nextIdx = (currentIdx + 1) % MUSCLE_CATEGORIES.length;
        switchMuscleCategory(MUSCLE_CATEGORIES[nextIdx].key, true);
    }

    function setupMuscleCarouselSwipe() {
        const viewport = document.getElementById('muscleCarouselViewport');
        const track = document.getElementById('muscleCarouselTrack');
        const indicator = document.getElementById('muscleTabIndicator');
        if (!viewport || !track) return;

        let isPointerDown = false;
        let isHorizontalSwipe = false;
        let isVerticalScroll = false;
        let startX = 0;
        let startY = 0;
        let startTime = 0;
        let deltaX = 0;
        let didDragMove = false;

        const onStart = (clientX, clientY) => {
            if (activeExpandedType || isSquareAnimating) return;
            isPointerDown = true;
            isHorizontalSwipe = false;
            isVerticalScroll = false;
            didDragMove = false;
            startX = clientX;
            startY = clientY;
            startTime = performance.now();
            deltaX = 0;
        };

        const onMove = (clientX, clientY, preventDefaultFn) => {
            if (!isPointerDown || isVerticalScroll) return;

            const dx = clientX - startX;
            const dy = clientY - startY;

            if (!isHorizontalSwipe) {
                if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
                if (Math.abs(dy) > Math.abs(dx) * 1.15) {
                    isVerticalScroll = true;
                    isPointerDown = false;
                    return;
                }
                isHorizontalSwipe = true;
                didDragMove = true;
                viewport.classList.add('is-dragging');
                track.classList.add('no-transition');
                if (indicator) indicator.style.transition = 'none';
            }

            if (preventDefaultFn) preventDefaultFn();

            const currentIdx = getMuscleIndex(activeMuscleCategory);
            let resistedDx = dx;
            if ((currentIdx === 0 && dx > 0) || (currentIdx === MUSCLE_CATEGORIES.length - 1 && dx < 0)) {
                resistedDx = dx * 0.3;
            }
            deltaX = resistedDx;

            const viewportWidth = viewport.clientWidth || 360;
            const basePercent = -currentIdx * 25;
            const dragPercent = (resistedDx / viewportWidth) * 25;
            track.style.transform = `translate3d(${basePercent + dragPercent}%, 0, 0)`;

            if (indicator) {
                const progressIndex = currentIdx - (resistedDx / viewportWidth);
                indicator.style.transform = `translate3d(calc(${progressIndex * 100}% + ${progressIndex * 6}px), 0, 0)`;
            }
        };

        const onEnd = () => {
            if (!isPointerDown) return;
            isPointerDown = false;
            viewport.classList.remove('is-dragging');

            if (!isHorizontalSwipe) return;

            const viewportWidth = viewport.clientWidth || 360;
            const elapsedMs = Math.max(1, performance.now() - startTime);
            const velocityPxPerMs = Math.abs(deltaX) / elapsedMs;
            const distanceThreshold = Math.min(64, viewportWidth * 0.18);
            const isQuickFlick = velocityPxPerMs > 0.42 && Math.abs(deltaX) > 24;

            const currentIdx = getMuscleIndex(activeMuscleCategory);
            let targetIdx = currentIdx;

            if ((deltaX < -distanceThreshold || (isQuickFlick && deltaX < 0)) && currentIdx < MUSCLE_CATEGORIES.length - 1) {
                targetIdx = currentIdx + 1;
            } else if ((deltaX > distanceThreshold || (isQuickFlick && deltaX > 0)) && currentIdx > 0) {
                targetIdx = currentIdx - 1;
            }

            switchMuscleCategory(MUSCLE_CATEGORIES[targetIdx].key, true);
        };

        viewport.addEventListener('click', e => {
            if (didDragMove) {
                e.stopPropagation();
                e.preventDefault();
                didDragMove = false;
            }
        }, true);

        viewport.addEventListener('touchstart', e => {
            if (e.touches.length === 1) onStart(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: true });

        viewport.addEventListener('touchmove', e => {
            if (e.touches.length === 1) {
                onMove(e.touches[0].clientX, e.touches[0].clientY, () => {
                    if (e.cancelable) e.preventDefault();
                });
            }
        }, { passive: false });

        viewport.addEventListener('touchend', onEnd);
        viewport.addEventListener('touchcancel', onEnd);

        viewport.addEventListener('mousedown', e => {
            if (e.button === 0) onStart(e.clientX, e.clientY);
        });
        window.addEventListener('mousemove', e => {
            if (isPointerDown) onMove(e.clientX, e.clientY, null);
        });
        window.addEventListener('mouseup', () => {
            if (isPointerDown) onEnd();
        });
    }

    /* ==========================================================================
       SYMETRICKÁ FLIP EXPANZE DLAŽDICE TAM I ZPĚT
       ========================================================================== */
    function resolveOriginTile(type, machineId, explicitEl) {
        if (explicitEl && document.body.contains(explicitEl)) return explicitEl;
        if (type === 'weight') return document.getElementById('tile-weight');
        if (type === 'add') return document.getElementById(`tile-add-${activeMuscleCategory}`);
        if (type === 'machine' && machineId) return document.getElementById(`tile-machine-${machineId}`);
        return null;
    }

    function computeFlipTransform(originEl, cardEl) {
        if (!originEl || !cardEl) {
            return 'translate3d(0px, 36px, 0px) scale(0.55, 0.55)';
        }
        const first = originEl.getBoundingClientRect();
        const last = cardEl.getBoundingClientRect();
        if (!first.width || !first.height || !last.width || !last.height) {
            return 'translate3d(0px, 36px, 0px) scale(0.55, 0.55)';
        }

        const firstCenterX = first.left + first.width / 2;
        const firstCenterY = first.top + first.height / 2;
        const lastCenterX = last.left + last.width / 2;
        const lastCenterY = last.top + last.height / 2;

        const dx = firstCenterX - lastCenterX;
        const dy = firstCenterY - lastCenterY;
        const sx = Math.max(0.2, first.width / last.width);
        const sy = Math.max(0.2, first.height / last.height);

        return `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0px) scale(${sx.toFixed(4)}, ${sy.toFixed(4)})`;
    }

    function openExpandedSquare(type, machineId = null, originEl = null) {
        if (isSquareAnimating) return;

        const backdrop = document.getElementById('tileBackdrop');
        const stage = document.getElementById('expandedSquareStage');
        const card = document.getElementById('expandedSquareCard');
        const addView = document.getElementById('expandedAddView');
        const weightView = document.getElementById('expandedWeightView');
        const machineView = document.getElementById('expandedMachineView');
        const titleEl = document.getElementById('expandedSquareTitle');
        const subEl = document.getElementById('expandedSquareSub');
        const iconEl = document.getElementById('expandedSquareIcon');

        const wasAlreadyOpen = stage.classList.contains('active');

        if (activeOriginTileEl) {
            activeOriginTileEl.classList.remove('tile-is-origin');
        }

        activeExpandedType = type;
        activeExpandedMachineId = machineId;
        activeOriginTileEl = resolveOriginTile(type, machineId, originEl);

        addView.style.display = 'none';
        weightView.style.display = 'none';
        machineView.style.display = 'none';

        if (type === 'add') {
            if (!document.getElementById('editMachineId').value) {
                resetMachineForm();
            }
            const isEditing = Boolean(document.getElementById('editMachineId').value);
            const catLabel = getMuscleLabel(document.getElementById('machineCategoryInput').value || activeMuscleCategory);
            titleEl.textContent = isEditing ? 'Upravit stroj / PR' : `Přidat stroj (${catLabel})`;
            subEl.textContent = 'Vyplň údaje a klepnutím na hlavičku zmenšíš';
            iconEl.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>`;
            addView.style.display = 'block';
        } else if (type === 'weight') {
            titleEl.textContent = 'Tělesná váha & Progres';
            subEl.textContent = 'Zapiš hmotnost, datum a sleduj křivku vývoje';
            iconEl.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 9 9"></path><path d="M12 12l5.5-5.5"></path><circle cx="12" cy="12" r="2"></circle></svg>`;
            weightView.style.display = 'block';
            const dateInput = document.getElementById('bodyWeightDateInput');
            if (dateInput && !dateInput.value) dateInput.value = getTodayIsoDate();
        } else if (type === 'machine') {
            const m = machines.find(item => item.id === machineId);
            if (!m) return;
            titleEl.textContent = m.name;
            subEl.textContent = `${getMuscleLabel(m.category)} • PR: ${m.pr} kg • ${m.sets} × ${m.reps}`;
            iconEl.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M6.5 6.5h11"></path><path d="M6.5 17.5h11"></path><path d="M3 10v4"></path><path d="M21 10v4"></path><path d="M6.5 4v16"></path><path d="M17.5 4v16"></path></svg>`;
            renderExpandedMachineDetail(m);
            machineView.style.display = 'block';
        }

        if (activeOriginTileEl) {
            activeOriginTileEl.classList.add('tile-is-origin');
        }

        if (wasAlreadyOpen) {
            card.style.transition = 'transform 0.26s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.2s ease';
            card.style.transform = 'translate3d(20px, 0, 0) scale(0.97)';
            card.style.opacity = '0.75';
            requestAnimationFrame(() => {
                card.style.transform = 'translate3d(0, 0, 0) scale(1)';
                card.style.opacity = '1';
                if (type === 'weight') drawWeightChart();
            });
            return;
        }

        isSquareAnimating = true;
        card.style.transition = 'none';
        card.style.opacity = '0.35';
        card.style.borderRadius = '38px';
        stage.classList.add('active');
        backdrop.classList.add('active');

        const startTransform = computeFlipTransform(activeOriginTileEl, card);
        card.style.transform = startTransform;

        if (type === 'weight') {
            drawWeightChart();
        }

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                card.style.transition = 'transform 0.36s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, border-radius 0.34s cubic-bezier(0.22, 1, 0.36, 1)';
                card.style.transform = 'translate3d(0px, 0px, 0px) scale(1, 1)';
                card.style.opacity = '1';
                card.style.borderRadius = '26px';

                setTimeout(() => {
                    isSquareAnimating = false;
                    if (type === 'weight') drawWeightChart();
                }, 365);
            });
        });
    }

    function closeExpandedSquare() {
        const backdrop = document.getElementById('tileBackdrop');
        const stage = document.getElementById('expandedSquareStage');
        const card = document.getElementById('expandedSquareCard');

        if ((!activeExpandedType && !stage.classList.contains('active')) || isSquareAnimating) return;

        isSquareAnimating = true;
        const closingType = activeExpandedType;
        const targetOrigin = resolveOriginTile(activeExpandedType, activeExpandedMachineId, activeOriginTileEl);
        const endTransform = computeFlipTransform(targetOrigin, card);

        backdrop.classList.remove('active');
        card.style.transition = 'transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.24s ease, border-radius 0.32s cubic-bezier(0.22, 1, 0.36, 1)';
        card.style.transform = endTransform;
        card.style.opacity = '0';
        card.style.borderRadius = '38px';

        setTimeout(() => {
            if (closingType === 'add') {
                resetMachineForm();
            }
            if (targetOrigin) {
                targetOrigin.classList.remove('tile-is-origin');
            }
            if (activeOriginTileEl) {
                activeOriginTileEl.classList.remove('tile-is-origin');
            }
            stage.classList.remove('active');
            card.style.transition = 'none';
            card.style.transform = '';
            card.style.opacity = '';
            card.style.borderRadius = '';
            activeExpandedType = null;
            activeExpandedMachineId = null;
            activeOriginTileEl = null;
            isSquareAnimating = false;
        }, 325);
    }

    function setupExpandedSwipeGesture() {
        const topBar = document.getElementById('expandedTopBar');
        const card = document.getElementById('expandedSquareCard');
        if (!topBar || !card) return;

        let startY = 0;
        let currentDeltaY = 0;
        let swiping = false;

        topBar.addEventListener('touchstart', e => {
            if (e.touches.length !== 1 || isSquareAnimating) return;
            startY = e.touches[0].clientY;
            currentDeltaY = 0;
            swiping = true;
            card.style.transition = 'none';
        }, { passive: true });

        topBar.addEventListener('touchmove', e => {
            if (!swiping || e.touches.length !== 1) return;
            const dy = e.touches[0].clientY - startY;
            if (dy > 0) {
                currentDeltaY = dy;
                const scale = Math.max(0.86, 1 - dy / 950);
                card.style.transform = `translate3d(0px, ${dy}px, 0px) scale(${scale})`;
            }
        }, { passive: true });

        topBar.addEventListener('touchend', () => {
            if (!swiping) return;
            swiping = false;
            if (currentDeltaY > 75) {
                closeExpandedSquare();
            } else {
                card.style.transition = 'transform 0.28s cubic-bezier(0.22, 1, 0.36, 1)';
                card.style.transform = 'translate3d(0px, 0px, 0px) scale(1, 1)';
            }
        });
    }

    /* ==========================================================================
       TĚLESNÁ VÁHA, MINI SPARKLINE & INTERAKTIVNÍ KŘIVKOVÝ GRAF
       ========================================================================== */
    function toggleWeightHistoryDrawer() {
        const wrap = document.getElementById('weightHistoryWrap');
        if (wrap) wrap.classList.toggle('open');
    }

    function logBodyWeight() {
        const weightInput = document.getElementById('bodyWeightInput');
        const dateInput = document.getElementById('bodyWeightDateInput');
        const val = parseFloat(weightInput.value);
        const isoDate = (dateInput && dateInput.value) ? dateInput.value : getTodayIsoDate();

        if (!val || val <= 0) {
            showToast('Zadej platnou tělesnou váhu v kg.');
            return;
        }

        const existingIdx = bodyWeights.findIndex(item => item.isoDate === isoDate);
        const newEntry = {
            id: Date.now().toString(),
            isoDate,
            date: formatDisplayDate(isoDate),
            weight: Number(val.toFixed(1))
        };

        if (existingIdx !== -1) {
            bodyWeights[existingIdx] = newEntry;
        } else {
            bodyWeights.push(newEntry);
        }

        bodyWeights.sort((a, b) => (a.isoDate || '').localeCompare(b.isoDate || ''));

        try {
            localStorage.setItem('gym_weights', JSON.stringify(bodyWeights));
        } catch (e) {
            showToast('Nepodařilo se uložit váhu do paměti.');
            return;
        }

        weightInput.value = '';
        activeChartPointIndex = bodyWeights.length - 1;
        renderWeights();
        showToast(`Váha ${newEntry.weight} kg zapsána!`);
    }

    function deleteWeightEntry(id) {
        bodyWeights = bodyWeights.filter(item => item.id !== id);
        localStorage.setItem('gym_weights', JSON.stringify(bodyWeights));
        activeChartPointIndex = bodyWeights.length > 0 ? bodyWeights.length - 1 : null;
        renderWeights();
        showToast('Záznam váhy smazán.');
    }

    function renderMiniWeightSparkline() {
        const box = document.getElementById('weightMiniSparkline');
        if (!box) return;
        if (bodyWeights.length < 2) {
            box.innerHTML = '';
            return;
        }
        const recent = bodyWeights.slice(-8);
        const vals = recent.map(w => w.weight);
        const min = Math.min(...vals);
        const max = Math.max(...vals);
        const span = max - min || 1;
        const w = 62;
        const h = 28;
        const pad = 3;

        const pts = recent.map((entry, idx) => {
            const x = pad + (idx / (recent.length - 1)) * (w - pad * 2);
            const y = pad + (h - pad * 2) - ((entry.weight - min) / span) * (h - pad * 2);
            return `${x.toFixed(1)},${y.toFixed(1)}`;
        });
        const lastPt = pts[pts.length - 1].split(',');

        box.innerHTML = `
            <svg viewBox="0 0 ${w} ${h}">
                <polyline fill="none" stroke="#ff3b30" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" points="${pts.join(' ')}"></polyline>
                <circle cx="${lastPt[0]}" cy="${lastPt[1]}" r="2.8" fill="#ffffff" stroke="#e61919" stroke-width="1.4"></circle>
            </svg>
        `;
    }

    function renderWeights() {
        const mainValEl = document.getElementById('weightTileMainVal');
        const diffBadgeEl = document.getElementById('weightTileDiffBadge');
        const lastDateEl = document.getElementById('weightTileLastDate');
        const historyWrap = document.getElementById('weightHistoryWrap');
        const historyList = document.getElementById('weightHistoryList');
        const countEl = document.getElementById('weightHistoryCount');

        renderMiniWeightSparkline();

        if (bodyWeights.length === 0) {
            mainValEl.innerHTML = `-- <small>kg</small>`;
            diffBadgeEl.textContent = 'Bez záznamu';
            diffBadgeEl.classList.remove('positive');
            lastDateEl.textContent = 'Zapiš první váhu';
            historyWrap.style.display = 'none';
            drawWeightChart();
            return;
        }

        const latest = bodyWeights[bodyWeights.length - 1];
        const first = bodyWeights[0];
        const diff = (latest.weight - first.weight).toFixed(1);

        mainValEl.innerHTML = `${latest.weight} <small>kg</small>`;
        lastDateEl.textContent = `Měřeno: ${latest.date || formatDisplayDate(latest.isoDate)}`;

        if (bodyWeights.length === 1) {
            diffBadgeEl.textContent = 'Startovní váha';
            diffBadgeEl.classList.remove('positive');
        } else {
            const numDiff = parseFloat(diff);
            const sign = numDiff > 0 ? '+' : '';
            diffBadgeEl.textContent = `${sign}${diff} kg`;
            if (numDiff < 0) {
                diffBadgeEl.classList.add('positive');
            } else {
                diffBadgeEl.classList.remove('positive');
            }
        }

        historyWrap.style.display = 'block';
        if (countEl) countEl.textContent = bodyWeights.length;

        const reversed = [...bodyWeights].reverse();
        historyList.innerHTML = reversed.map(entry => `
            <div class="weight-history-item">
                <span>${escapeHtml(entry.date || formatDisplayDate(entry.isoDate))}</span>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <strong style="color: #ff8a8a;">${entry.weight} kg</strong>
                    <button type="button" class="weight-del-btn" onclick="deleteWeightEntry('${entry.id}')" aria-label="Smazat záznam váhy">&times;</button>
                </div>
            </div>
        `).join('');

        drawWeightChart();
    }

    function drawWeightChart() {
        const canvas = document.getElementById('weightChart');
        if (!canvas) return;
        const rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;

        const dpr = window.devicePixelRatio || 1;
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        const ctx = canvas.getContext('2d');
        ctx.scale(dpr, dpr);

        const w = rect.width;
        const h = rect.height;
        ctx.clearRect(0, 0, w, h);
        chartPointCoords = [];

        const tooltipEl = document.getElementById('chartTooltip');

        if (bodyWeights.length === 0) {
            ctx.fillStyle = '#8b8286';
            ctx.font = '700 12px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('Zapiš váhu a sleduj křivku svého progresu', w / 2, h / 2 + 4);
            if (tooltipEl) tooltipEl.textContent = 'Zatím bez dat';
            return;
        }

        const padLeft = 40;
        const padRight = 16;
        const padTop = 32;
        const padBottom = 26;
        const plotW = Math.max(10, w - padLeft - padRight);
        const plotH = Math.max(10, h - padTop - padBottom);

        const weights = bodyWeights.map(item => item.weight);
        let minW = Math.min(...weights);
        let maxW = Math.max(...weights);

        if (minW === maxW) {
            minW -= 1.5;
            maxW += 1.5;
        } else {
            const span = maxW - minW;
            minW -= span * 0.16;
            maxW += span * 0.16;
        }

        const gridSteps = 3;
        ctx.font = '700 10px Inter, sans-serif';
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';

        for (let i = 0; i <= gridSteps; i++) {
            const ratio = i / gridSteps;
            const y = padTop + ratio * plotH;
            const valLabel = (maxW - ratio * (maxW - minW)).toFixed(1);

            ctx.strokeStyle = 'rgba(255, 255, 255, 0.07)';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(padLeft, y);
            ctx.lineTo(w - padRight, y);
            ctx.stroke();

            ctx.fillStyle = '#9a9095';
            ctx.fillText(`${valLabel}`, padLeft - 6, y);
        }

        bodyWeights.forEach((item, idx) => {
            const x = bodyWeights.length === 1
                ? padLeft + plotW / 2
                : padLeft + (idx / (bodyWeights.length - 1)) * plotW;
            const normY = (item.weight - minW) / (maxW - minW);
            const y = padTop + plotH - normY * plotH;
            chartPointCoords.push({ x, y, item, idx });
        });

        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillStyle = '#9a9095';
        const labelIndices = new Set([0, Math.floor((chartPointCoords.length - 1) / 2), chartPointCoords.length - 1]);
        labelIndices.forEach(idx => {
            const pt = chartPointCoords[idx];
            if (pt) {
                const shortD = formatShortDate(pt.item.isoDate || pt.item.date);
                ctx.fillText(shortD, pt.x, h - padBottom + 7);
            }
        });

        if (chartPointCoords.length >= 2) {
            const drawSmoothPath = () => {
                ctx.beginPath();
                ctx.moveTo(chartPointCoords[0].x, chartPointCoords[0].y);
                for (let i = 0; i < chartPointCoords.length - 1; i++) {
                    const p0 = chartPointCoords[i === 0 ? i : i - 1];
                    const p1 = chartPointCoords[i];
                    const p2 = chartPointCoords[i + 1];
                    const p3 = chartPointCoords[i + 2 < chartPointCoords.length ? i + 2 : i + 1];

                    const cp1x = p1.x + (p2.x - p0.x) / 6;
                    const cp1y = p1.y + (p2.y - p0.y) / 6;
                    const cp2x = p2.x - (p3.x - p1.x) / 6;
                    const cp2y = p2.y - (p3.y - p1.y) / 6;
                    ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, p2.x, p2.y);
                }
            };

            drawSmoothPath();
            ctx.lineTo(chartPointCoords[chartPointCoords.length - 1].x, padTop + plotH);
            ctx.lineTo(chartPointCoords[0].x, padTop + plotH);
            ctx.closePath();

            const grad = ctx.createLinearGradient(0, padTop, 0, padTop + plotH);
            grad.addColorStop(0, 'rgba(230, 25, 25, 0.36)');
            grad.addColorStop(1, 'rgba(230, 25, 25, 0.0)');
            ctx.fillStyle = grad;
            ctx.fill();

            drawSmoothPath();
            ctx.strokeStyle = '#ff3b30';
            ctx.lineWidth = 3;
            ctx.lineCap = 'round';
            ctx.stroke();
        }

        const selectedIdx = (activeChartPointIndex !== null && chartPointCoords[activeChartPointIndex])
            ? activeChartPointIndex
            : chartPointCoords.length - 1;

        chartPointCoords.forEach((pt, idx) => {
            const isSelected = idx === selectedIdx;
            if (isSelected) {
                ctx.beginPath();
                ctx.arc(pt.x, pt.y, 8, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(230, 25, 25, 0.34)';
                ctx.fill();
            }

            ctx.beginPath();
            ctx.arc(pt.x, pt.y, isSelected ? 4.6 : 3.2, 0, Math.PI * 2);
            ctx.fillStyle = isSelected ? '#ffffff' : '#ff5722';
            ctx.fill();
            ctx.lineWidth = 1.5;
            ctx.strokeStyle = '#140c0e';
            ctx.stroke();
        });

        const activePt = chartPointCoords[selectedIdx];
        if (activePt && tooltipEl) {
            const dText = activePt.item.date || formatDisplayDate(activePt.item.isoDate);
            tooltipEl.textContent = `${dText}: ${activePt.item.weight} kg`;
        }
    }

    function setupChartInteraction() {
        const canvas = document.getElementById('weightChart');
        if (!canvas) return;

        const pickNearestPoint = (clientX) => {
            if (!chartPointCoords.length) return;
            const rect = canvas.getBoundingClientRect();
            const relX = clientX - rect.left;

            let bestIdx = 0;
            let bestDist = Infinity;
            chartPointCoords.forEach((pt, idx) => {
                const d = Math.abs(pt.x - relX);
                if (d < bestDist) {
                    bestDist = d;
                    bestIdx = idx;
                }
            });

            if (activeChartPointIndex !== bestIdx) {
                activeChartPointIndex = bestIdx;
                drawWeightChart();
            }
        };

        canvas.addEventListener('click', e => pickNearestPoint(e.clientX));
        canvas.addEventListener('touchstart', e => {
            if (e.touches.length === 1) pickNearestPoint(e.touches[0].clientX);
        }, { passive: true });
        canvas.addEventListener('touchmove', e => {
            if (e.touches.length === 1) pickNearestPoint(e.touches[0].clientX);
        }, { passive: true });
    }

    /* ==========================================================================
       INTERAKTIVNÍ 4:3 OŘEZÁVAČ FOTKY STROJE (TOUCH & MYŠ)
       ========================================================================== */
    function handleImageSelect(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            const img = new Image();
            img.onload = function() {
                rawImageObj = img;
                existingCroppedData = null;
                document.getElementById('uploadTrigger').style.display = 'none';
                document.getElementById('cropperWrapper').style.display = 'block';

                const preview = document.getElementById('cropImage');
                preview.src = e.target.result;

                const box = document.getElementById('cropperBox');
                const boxRatio = (box.clientWidth || 320) / (box.clientHeight || 240);
                const imgRatio = img.width / img.height;

                if (imgRatio > boxRatio) {
                    cropState.baseH = box.clientHeight || 240;
                    cropState.baseW = cropState.baseH * imgRatio;
                } else {
                    cropState.baseW = box.clientWidth || 320;
                    cropState.baseH = cropState.baseW / imgRatio;
                }

                preview.style.width = `${cropState.baseW}px`;
                preview.style.height = `${cropState.baseH}px`;

                cropState.scale = 1;
                cropState.x = 0;
                cropState.y = 0;
                document.getElementById('zoomSlider').value = 1;
                updateCropTransform();
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    function updateCropTransform() {
        cropState.scale = parseFloat(document.getElementById('zoomSlider').value) || 1;
        const preview = document.getElementById('cropImage');
        preview.style.transform = `translate(calc(-50% + ${cropState.x}px), calc(-50% + ${cropState.y}px)) scale(${cropState.scale})`;
    }

    function setupCropperGestures() {
        const box = document.getElementById('cropperBox');
        if (!box) return;

        const startDrag = (clientX, clientY) => {
            cropState.dragging = true;
            cropState.startX = clientX - cropState.x;
            cropState.startY = clientY - cropState.y;
        };

        const moveDrag = (clientX, clientY) => {
            if (!cropState.dragging) return;
            cropState.x = clientX - cropState.startX;
            cropState.y = clientY - cropState.startY;
            updateCropTransform();
        };

        const endDrag = () => {
            cropState.dragging = false;
        };

        box.addEventListener('mousedown', e => startDrag(e.clientX, e.clientY));
        window.addEventListener('mousemove', e => moveDrag(e.clientX, e.clientY));
        window.addEventListener('mouseup', endDrag);

        box.addEventListener('touchstart', e => {
            if (e.touches.length === 1) startDrag(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: true });

        box.addEventListener('touchmove', e => {
            if (e.touches.length === 1 && cropState.dragging) {
                e.preventDefault();
                moveDrag(e.touches[0].clientX, e.touches[0].clientY);
            }
        }, { passive: false });

        box.addEventListener('touchend', endDrag);
    }

    function getCroppedBase64() {
        if (!rawImageObj) return existingCroppedData || null;

        const box = document.getElementById('cropperBox');
        const outW = 800;
        const outH = 600;
        const canvas = document.createElement('canvas');
        canvas.width = outW;
        canvas.height = outH;
        const ctx = canvas.getContext('2d');

        ctx.fillStyle = '#090708';
        ctx.fillRect(0, 0, outW, outH);

        const boxW = box.clientWidth || 320;
        const boxH = box.clientHeight || 240;
        const ratioX = outW / boxW;
        const ratioY = outH / boxH;

        const drawW = cropState.baseW * cropState.scale * ratioX;
        const drawH = cropState.baseH * cropState.scale * ratioY;
        const drawX = (outW - drawW) / 2 + (cropState.x * ratioX);
        const drawY = (outH - drawH) / 2 + (cropState.y * ratioY);

        ctx.drawImage(rawImageObj, drawX, drawY, drawW, drawH);
        return canvas.toDataURL('image/jpeg', 0.84);
    }

    /* ==========================================================================
       SPRÁVA STROJŮ (PŘIDÁNÍ, ÚPRAVA, DETAIL, SMAZÁNÍ) PRO KAŽDOU PARTII
       ========================================================================== */
    function resetMachineForm() {
        document.getElementById('editMachineId').value = '';
        document.getElementById('machineCategoryInput').value = activeMuscleCategory;
        document.getElementById('machineNameInput').value = '';
        document.getElementById('machinePrInput').value = '';
        document.getElementById('machineSetsInput').value = '';
        document.getElementById('machineRepsInput').value = '';
        document.getElementById('photoInput').value = '';
        document.getElementById('uploadTrigger').style.display = 'block';
        document.getElementById('cropperWrapper').style.display = 'none';
        rawImageObj = null;
        existingCroppedData = null;
    }

    function startEditMachine(id) {
        const m = machines.find(item => item.id === id);
        if (!m) return;

        resetMachineForm();
        document.getElementById('editMachineId').value = m.id;
        document.getElementById('machineCategoryInput').value = m.category || activeMuscleCategory;
        document.getElementById('machineNameInput').value = m.name;
        document.getElementById('machinePrInput').value = m.pr;
        document.getElementById('machineSetsInput').value = m.sets;
        document.getElementById('machineRepsInput').value = m.reps;
        existingCroppedData = m.photo || null;

        openExpandedSquare('add', null, document.getElementById(`tile-machine-${id}`));
    }

    function saveMachine() {
        const id = document.getElementById('editMachineId').value;
        const category = document.getElementById('machineCategoryInput').value || activeMuscleCategory;
        const name = document.getElementById('machineNameInput').value.trim();
        const pr = parseFloat(document.getElementById('machinePrInput').value) || 0;
        const sets = parseInt(document.getElementById('machineSetsInput').value, 10) || 0;
        const reps = parseInt(document.getElementById('machineRepsInput').value, 10) || 0;

        if (!name) {
            showToast('Vyplň prosím název stroje.');
            return;
        }

        const photoData = getCroppedBase64();
        let targetId = id;

        if (id) {
            const index = machines.findIndex(m => m.id === id);
            if (index !== -1) {
                machines[index] = {
                    ...machines[index],
                    category,
                    name,
                    pr,
                    sets,
                    reps,
                    photo: photoData || machines[index].photo
                };
            }
        } else {
            targetId = Date.now().toString();
            machines.unshift({
                id: targetId,
                category,
                name,
                pr,
                sets,
                reps,
                photo: photoData
            });
        }

        try {
            localStorage.setItem('gym_machines', JSON.stringify(machines));
            renderMachines();
            if (activeMuscleCategory !== category) {
                switchMuscleCategory(category, true);
            } else {
                updateMuscleUIState();
            }
            if (!id) {
                activeExpandedMachineId = targetId;
                activeOriginTileEl = document.getElementById(`tile-machine-${targetId}`) || document.getElementById(`tile-add-${category}`);
            }
            closeExpandedSquare();
            showToast(id ? 'Data stroje aktualizována!' : `Stroj přidán do partie ${getMuscleLabel(category)}!`);
        } catch (e) {
            showToast('Paměť prohlížeče je plná. Zkus menší fotku.');
        }
    }

    function requestDeleteMachine(id) {
        const m = machines.find(item => item.id === id);
        if (!m) return;
        pendingDeleteId = id;
        document.getElementById('deleteConfirmText').textContent = `Opravdu chceš odstranit stroj „${m.name}“ a jeho zapsané PR?`;
        document.getElementById('deleteConfirmModal').classList.add('active');
    }

    function closeDeleteModal() {
        pendingDeleteId = null;
        document.getElementById('deleteConfirmModal').classList.remove('active');
    }

    function confirmDeleteMachine() {
        if (!pendingDeleteId) return;
        machines = machines.filter(m => m.id !== pendingDeleteId);
        localStorage.setItem('gym_machines', JSON.stringify(machines));
        closeDeleteModal();
        renderMachines();
        updateMuscleUIState();
        closeExpandedSquare();
        showToast('Stroj byl odstraněn.');
    }

    function renderExpandedMachineDetail(m) {
        const container = document.getElementById('expandedMachineView');
        const safeName = escapeHtml(m.name);
        const catLabel = getMuscleLabel(m.category);
        const totalVolume = Math.round((Number(m.pr) || 0) * (Number(m.sets) || 0) * (Number(m.reps) || 0));

        container.innerHTML = `
            ${m.photo ? `
                <div class="detail-photo-frame">
                    <img src="${m.photo}" alt="${safeName}">
                </div>
            ` : ''}

            <div class="detail-category-row">
                <span class="detail-category-badge">Partie: ${catLabel}</span>
                <span class="detail-volume-badge">${totalVolume > 0 ? `Objem série: ${totalVolume} kg` : 'Zapiš série a opakování'}</span>
            </div>

            <div class="detail-metrics-grid">
                <div>
                    <span class="detail-metric-label">Max PR</span>
                    <span class="detail-metric-value accent">${m.pr} kg</span>
                </div>
                <div>
                    <span class="detail-metric-label">Série</span>
                    <span class="detail-metric-value">${m.sets}</span>
                </div>
                <div>
                    <span class="detail-metric-label">Opakování</span>
                    <span class="detail-metric-value">${m.reps}</span>
                </div>
            </div>

            <div class="form-row-2">
                <button type="button" class="btn btn-secondary" onclick="startEditMachine('${m.id}')">Upravit PR / data</button>
                <button type="button" class="btn btn-danger" onclick="requestDeleteMachine('${m.id}')">Smazat</button>
            </div>
        `;
    }

    function renderMachines() {
        const headerPill = document.getElementById('headerSummaryPill');
        const maxPr = machines.length > 0 ? Math.max(...machines.map(m => Number(m.pr) || 0)) : 0;
        const totalWord = machines.length === 1 ? 'stroj' : (machines.length >= 2 && machines.length <= 4 ? 'stroje' : 'strojů');

        if (headerPill) {
            headerPill.textContent = `${machines.length} ${totalWord} • Max PR ${maxPr} kg`;
        }

        // Vykreslení každé z 4 svalových partií (každá má stejnou čtvercovou dlaždici '+' a své uložené stroje)
        MUSCLE_CATEGORIES.forEach(cat => {
            const catMachines = machines.filter(m => (m.category || 'ruce') === cat.key);
            const badge = document.getElementById(`tabCount-${cat.key}`);
            if (badge) {
                badge.textContent = catMachines.length;
            }

            const gridEl = document.getElementById(`grid-${cat.key}`);
            if (!gridEl) return;

            const addTileHtml = `
                <button type="button" class="sq-tile add-tile" id="tile-add-${cat.key}" onclick="openExpandedSquare('add', null, this)" aria-label="Přidat stroj (${cat.label})">
                    <div class="add-round-badge" aria-hidden="true">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                    </div>
                    <div>
                        <div class="tile-title" style="text-align: center;">Přidat stroj</div>
                        <div class="tile-sub" style="text-align: center;">${cat.label} • Fotka & PR</div>
                    </div>
                </button>
            `;

            const machineTilesHtml = catMachines.map(m => {
                const safeName = escapeHtml(m.name);
                return `
                    <button type="button" class="sq-tile machine-tile" id="tile-machine-${m.id}" onclick="openExpandedSquare('machine', '${m.id}', this)" aria-label="Otevřít detail stroje ${safeName}">
                        <div class="tile-top-row">
                            ${m.photo
                                ? `<img class="round-machine-thumb" src="${m.photo}" alt="${safeName}" loading="lazy">`
                                : `<div class="round-icon-badge" aria-hidden="true">
                                       <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                                           <path d="M6.5 6.5h11"></path>
                                           <path d="M6.5 17.5h11"></path>
                                           <path d="M3 10v4"></path>
                                           <path d="M21 10v4"></path>
                                           <path d="M6.5 4v16"></path>
                                           <path d="M17.5 4v16"></path>
                                       </svg>
                                   </div>`
                            }
                            <span class="tile-pill">PR ${m.pr} kg</span>
                        </div>

                        <div>
                            <div class="tile-title">${safeName}</div>
                            <div class="machine-mini-badges">
                                <span class="mini-chip pr">${m.pr} kg</span>
                                <span class="mini-chip">${m.sets} × ${m.reps}</span>
                            </div>
                        </div>
                    </button>
                `;
            }).join('');

            gridEl.innerHTML = addTileHtml + machineTilesHtml;
        });

        updateMuscleUIState();
    }
</script>

</body>
</html>
